# Public site URL (no trailing slash). Used for canonical URLs, Open Graph, and SEO.
# Production: https://ethiobuildconnect.et
VITE_PUBLIC_SITE_URL=https://ethiobuildconnect.et

# Support email for /privacy, /terms, /legal (defaults to info@ethiobuildconnect.et if unset)
# VITE_SUPPORT_EMAIL=info@ethiobuildconnect.et

# API base path or full URL (see src/shared/api/client.ts)
# VITE_API_BASE_URL=/api/v1

# Google Analytics 4 measurement ID. Defaults to the site's own property
# (G-0BDWXN060N) when unset, so a plain build still reports. Override it to point a
# staging deploy at another property, or set it empty to disable the tag entirely.
# The dev server never loads it either way.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
